+fn custom_names_cover_partial_outputs_sidecars_and_path_rejection() {
+    let dir = tmpdir("custom_names");
+    let separator_assets = tiny_separator_assets(&dir);
+    let separator = load_separator_with_options(
+        &separator_assets,
+        DeviceChoice::Cpu,
